# =====================================================================
# CONFIGURAÇÕES DE AMBIENTE - CONTROLE FINANCEIRO
# =====================================================================

# 1. Chave da API do Google Gemini (para análise financeira inteligente e OCR)
GEMINI_API_KEY="sua_chave_gemini_aqui"

# 2. Persistência em Banco de Dados (OPCIONAL)
# Por padrão, se omitido, o sistema utiliza o SQLite local padrão ("financas.db").
# Para persistência em nuvem (ex: Turso / LibSQL no Streamlit Cloud sem perda de dados no reboot):
# DATABASE_URL="libsql://seu-banco-usuario.turso.io"
# DATABASE_AUTH_TOKEN="seu_token_jwt_turso_aqui"

# Ou para utilizar um arquivo SQLite em caminho alternativo:
# DATABASE_URL="sqlite:///caminho/para/banco_personalizado.db"
